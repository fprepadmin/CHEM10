# ============================================================
# CHEM10 AI — Environment Variables Template
# Copy file này thành .env.local và điền giá trị thực vào.
# TUYỆT ĐỐI KHÔNG commit .env.local lên git!
# ============================================================

# Gemini API Key — dùng cho tạo câu hỏi AI và hỗ trợ học sinh
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Keys — dùng cho phân tích năng lực học sinh (AI Assessment)
# Dán nhiều keys cách nhau bởi dấu phẩy để tự động xoay vòng khi hết quota
# Lấy tại: https://console.groq.com/keys
VITE_GROQ_API_KEYS=

# URL ứng dụng — tự động inject bởi Cloud Run hoặc điền thủ công khi dev
APP_URL=http://localhost:3000
